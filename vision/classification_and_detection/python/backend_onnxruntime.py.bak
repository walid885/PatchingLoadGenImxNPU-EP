"""
onnxruntime backend (https://github.com/microsoft/onnxruntime)
"""

# pylint: disable=unused-argument,missing-docstring,useless-super-delegation

import onnxruntime as rt
import os
import backend


class BackendOnnxruntime(backend.Backend):
    def __init__(self):
        super(BackendOnnxruntime, self).__init__()
        self.arch = platform.machine()  # 'aarch64' on i.MX8M Plus, 'x86_64' on dev PC
        self.ort_ep = os.environ.get("ORT_EP", "CPU").upper()


    def version(self):
        return rt.__version__

    def name(self):
        """Name of the runtime."""
        return "onnxruntime"

    def image_format(self):
        """image_format. For onnx it is always NCHW."""
        return "NCHW"

    def load(self, model_path, inputs=None, outputs=None):
        """Load model and find input/outputs from the model file."""
        opt = rt.SessionOptions()

        # By default all optimizations are enabled
        # https://onnxruntime.ai/docs/performance/graph-optimizations.html
        # Enable only upto extended optimizations on aarch64 due to an accuracy
        # issue
        if os.environ.get("HOST_PLATFORM_FLAVOR", "") == "aarch64":
            opt.graph_optimization_level = rt.GraphOptimizationLevel.ORT_ENABLE_EXTENDED

        # self.sess = rt.InferenceSession(model_path, opt)
        """if len(rt.get_all_providers()) > 1 and os.environ.get(
            "USE_GPU", "yes"
        ).lower() not in ["0", "false", "off", "no"]:
            self.sess = rt.InferenceSession(
                model_path, opt, providers=["CUDAExecutionProvider"]
            )
        else:
            self.sess = rt.InferenceSession(
                model_path, opt, providers=["CPUExecutionProvider"]
            )"""
        
        providers = self._select_providers()
        self.sess = rt.InferenceSession(model_path, opt, providers=providers)


        # get input and output names
        if not inputs:
            self.inputs = [meta.name for meta in self.sess.get_inputs()]
        else:
            self.inputs = inputs
        if not outputs:
            self.outputs = [meta.name for meta in self.sess.get_outputs()]
        else:
            self.outputs = outputs
        return self
    
    # NEW method, insert after load(), before predict():

    def _select_providers(self):
        """Resolve EP list from ORT_EP env var + arch, with safe fallback."""
        available = rt.get_all_providers()

        if self.ort_ep == "NPU":
            if self.arch != "aarch64":
                # PC dry-run: mock NPU path, force CPU, log intent
                print(
                    f"[backend_onnxruntime] ORT_EP=NPU requested on {self.arch}; "
                    "no NPU hardware present, mocking with CPUExecutionProvider"
                )
                return ["CPUExecutionProvider"]

            if "VSINPUExecutionProvider" not in available:
                raise RuntimeError(
                    "ORT_EP=NPU requested on aarch64 but VSINPUExecutionProvider "
                    "not found in onnxruntime.get_all_providers(). "
                    "Install NXP's onnxruntime fork."
                )
            return ["VSINPUExecutionProvider", "CPUExecutionProvider"]

        if self.ort_ep == "CUDA":
            if "CUDAExecutionProvider" in available and os.environ.get(
                "USE_GPU", "yes"
            ).lower() not in ["0", "false", "off", "no"]:
                return ["CUDAExecutionProvider", "CPUExecutionProvider"]
            return ["CPUExecutionProvider"]

        # default / ORT_EP=CPU or unset
        return ["CPUExecutionProvider"]

    def predict(self, feed):
        """Run the prediction."""
        return self.sess.run(self.outputs, feed)
